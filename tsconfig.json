{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist",        // <--- Ez rakja külön mappába a JS fájlokat
    "rootDir": "./src"            // <--- Biztosítja a projektstruktúra megtartását
  },
  "include": ["./src/**/*.ts", "./*.ts"]
}