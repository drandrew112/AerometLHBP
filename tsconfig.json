{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",          // Node.js-hez a NodeNext a legbiztosabb
    "moduleResolution": "NodeNext",
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist",            // A lefordított JS fájlok helye
    "rootDir": "./",               // A gyökérből indul a feltérképezés
    "types": ["node"]              // Explicit módon mondjuk meg, hogy Node-ot használunk
  },
  "include": [
    "**/*.ts"                      // Mindent nézünk
  ],
  "exclude": [
    "node_modules",
    "web",                         // <--- KRITIKUS: Ne fordítsa bele a web mappát!
    "dist"                         // <--- Ne fordítsa önmagát
  ]
}